{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qep://agents/schemas/gate-report.schema.json",
  "title": "QEP Gate Report",
  "type": "object",
  "required": [
    "segment",
    "agent",
    "timestamp",
    "verdict",
    "mission_alignment",
    "checks"
  ],
  "properties": {
    "segment": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "GO",
        "NO_GO",
        "GO_WITH_WAIVER"
      ]
    },
    "mission_alignment": {
      "type": "object",
      "required": [
        "verdict",
        "evidence",
        "risk"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "waiver"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "risk": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "options": {
      "type": "object",
      "properties": {
        "ui": {
          "type": "boolean"
        },
        "chaos": {
          "type": "boolean"
        },
        "design_advisory": {
          "type": "boolean"
        },
        "local_only": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "skipped"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "command": {
            "type": "string"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "output": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "blocking_failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "title"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3",
              "ADVISORY"
            ]
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "local_only": {
      "type": "boolean"
    },
    "operational_acceptance": {
      "type": "boolean"
    },
    "isolation_manifest": {
      "type": "string",
      "minLength": 1
    },
    "isolation_cleanup_warning": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification_scope": {
      "type": "object",
      "required": [
        "kind",
        "local_only",
        "operational_acceptance",
        "label",
        "exclusions"
      ],
      "properties": {
        "kind": {
          "enum": [
            "isolated_local_technical_verification",
            "configured_registered_gate_chain"
          ]
        },
        "local_only": {
          "type": "boolean"
        },
        "operational_acceptance": {
          "type": "boolean"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environment": {
          "type": "object",
          "properties": {
            "inherited_variables": {
              "type": "string",
              "minLength": 1
            },
            "bun_dotenv": {
              "type": "string",
              "minLength": 1
            },
            "limitation": {
              "type": "string",
              "minLength": 1
            },
            "filesystem_sandbox": {
              "type": "boolean"
            },
            "network_sandbox": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "local_only"
        ],
        "properties": {
          "local_only": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "verification_scope",
          "operational_acceptance"
        ],
        "properties": {
          "verdict": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "operational_acceptance": {
            "const": false
          },
          "verification_scope": {
            "properties": {
              "kind": {
                "const": "isolated_local_technical_verification"
              },
              "local_only": {
                "const": true
              },
              "operational_acceptance": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
