# Copy to .env (never commit). All scripts read these from the environment.
# Keep this file placeholder-only. Real values belong in local .env / secret stores.

# --- Linear ---------------------------------------------------------------
# Personal API key — https://linear.app/settings/api -> Personal API keys
LINEAR_API_KEY=<linear-api-key>

# Team key (3-letter uppercase from Linear team settings)
LINEAR_TEAM_KEY=QEP

# Linear user ID owning the API key. Run `npm run whoami` to discover.
# Used by the reverse Edge Function to ignore webhooks it caused itself.
LINEAR_SYNC_USER_ID=<linear-user-id>

# Webhook signing secret from Linear -> Settings -> API -> Webhooks
# Used by the reverse Edge Function to verify request authenticity.
LINEAR_WEBHOOK_SECRET=<linear-webhook-signing-secret>

# --- Supabase --------------------------------------------------------------
# QEP production Supabase: iciddijgonywtxoelous
SUPABASE_URL=https://iciddijgonywtxoelous.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Alerting (optional) ---------------------------------------------------
# If set, alert-on-errors.mjs posts here. Slack incoming webhook URL.
# SLACK_WEBHOOK_URL=<slack-webhook-url>

# Thresholds for alert-on-errors.mjs
ALERT_ERROR_THRESHOLD=3
ALERT_RECENT_ERROR_THRESHOLD=5
ALERT_STALE_PENDING_THRESHOLD=5
ALERT_PENDING_BACKLOG_THRESHOLD=25
